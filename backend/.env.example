# ARK INFRA BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and fill in your values. NEVER commit the real .env file.

# Database (Localhost or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ark_infra_dev

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Default Seed Admin Credentials (created on first startup if no admin exists)
ADMIN_EMAIL=admin@arkinfravizag.com
ADMIN_PASSWORD=change_this_secure_password_123

# URLs & CORS
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://www.arkinfravizag.com

# Storage Configuration ('local' for localhost development, 'cloud' for S3/R2 in production)
STORAGE_MODE=local
UPLOAD_DIR=uploads

# Cloud Storage (Required when STORAGE_MODE=cloud)
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
CLOUD_STORAGE_PUBLIC_URL=

# Official WhatsApp API (Optional - safe fallback provided if empty)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
